# ─────────────────────────────────────────────────────────────────────────────
# n8n-hubspot-call-urgency-nlp-routing-engine — environment template
# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.
# Safe defaults: with these values a manual run scores synthetic transcripts,
# makes no AI calls, updates nothing in HubSpot and sends nothing to Slack.
# ─────────────────────────────────────────────────────────────────────────────

# ── Safety flags (leave as-is until staging is verified) ─────────────────────
SANDBOX_MODE=true
DRY_RUN=true
HUBSPOT_MUTATIONS_ENABLED=false
SEND_SLACK_ALERTS=false
SEND_OPS_ALERTS=false
AI_ANALYSIS_ENABLED=false
REDACT_PII=true

# ── Inbound webhook authentication (required for live deliveries) ───────────
INBOUND_WEBHOOK_SECRET=replace-with-long-random-shared-secret
INBOUND_WEBHOOK_SECRET_HEADER=x-webhook-secret
MAX_CALLS_PER_DELIVERY=50
MAX_TRANSCRIPT_CHARS=20000

# ── HubSpot private app (crm.objects.contacts.read/write, crm.objects.deals.read/write)
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
UPDATE_DEAL_RECORDS=true

# ── AI enrichment (optional; redacted prospect speech only) ──────────────────
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=replace-with-ai-provider-api-key
AI_BLEND_WEIGHT=0.6
AI_DISAGREEMENT_THRESHOLD=35
AI_TIMEOUT_MS=20000

# ── Urgency classification ───────────────────────────────────────────────────
URGENCY_MEDIUM_THRESHOLD=40
URGENCY_HIGH_THRESHOLD=65
URGENCY_CRITICAL_THRESHOLD=85
SENTIMENT_NEGATIVE_THRESHOLD=-0.25
SENTIMENT_POSITIVE_THRESHOLD=0.25

# ── Enterprise + escalation rules ────────────────────────────────────────────
ENTERPRISE_MIN_EMPLOYEES=1000
ENTERPRISE_MIN_DEAL_AMOUNT=50000
ENTERPRISE_MIN_SEATS=250
ESCALATION_MIN_LEVEL=high
ESCALATE_CRITICAL_NON_ENTERPRISE=true
ESCALATION_COOLDOWN_HOURS=24

# ── Slack + ops webhooks (placeholders) ──────────────────────────────────────
SLACK_ALERT_WEBHOOK_URL=https://hooks.example.com/slack/sales-leadership
SLACK_LEADERSHIP_WEBHOOK_URL=https://hooks.example.com/slack/executive-escalations
ALERT_WEBHOOK_URL=https://alerts.example.com/ops/call-urgency-router

# ── Optional: pin the run clock (ISO 8601) for reproducible tests ────────────
RUN_TIMESTAMP_OVERRIDE=

# ── n8n instance setting: Code nodes and expressions must be able to read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
